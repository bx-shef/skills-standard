# Скопировать в .env рядом с docker-compose.prod.yml (umask 077 — файл только владельцу).

# Домен приёмника. DNS A-запись — на сервер ДО make prod-up, иначе сертификат не выпустится.
DOMAIN=feedback.example.org
# E-mail для Let's Encrypt или пусто (адреса на example.com Let's Encrypt отвергает).
LETSENCRYPT_EMAIL=

# Токен на чтение отзывов (GET /feedback, /feedback.md). Обязателен: вставить ВЫВОД команды
# openssl rand -hex 32 (сам текст команды .env не выполнит — токеном станет эта строка).
FEEDBACK_READ_TOKEN=
# Читать отзывы снаружи (https://<DOMAIN>/feedback.md с токеном). 0 — только make read на сервере.
FEEDBACK_READ_REMOTE=0
# Токен на отправку. Пусто — отправка открыта (так нужно навыкам: агенты шлют без токена).
# Задан — POST только с Bearer: bxshef feedback send берёт его из BXSHEF_FEEDBACK_TOKEN.
FEEDBACK_TOKEN=

# Отправок в минуту: с одного адреса и всего. Сверх — 429. 0 или пусто — по умолчанию.
FEEDBACK_RATE=20
FEEDBACK_RATE_TOTAL=300
# Неверных токенов чтения в минуту с адреса; сверх — 429 до конца минуты.
FEEDBACK_AUTH_FAILS=5
# Предел хранилища: отзывов и мегабайт. Сверх — 507, пока старые не уйдут по сроку.
FEEDBACK_MAX_FILES=20000
FEEDBACK_MAX_MB=200
# Сколько дней хранить отзывы; 0 — не удалять.
FEEDBACK_RETENTION_DAYS=3
# Кому верить X-Forwarded-For: 1 — частной сети (proxy-net); имя контейнера nginx-proxy — только ему.
TRUST_PROXY=1
